@inherits LayoutComponentBase

<div class="main-container p-4">
    <!-- Floating Top Nav Dock -->
    <header class="liquid-glass-card mac-floating-nav d-flex justify-content-center align-items-center py-3">
        <h4 class="mb-0 fw-bolder text-success text-center" style="font-weight: 900;">Kuran Rehberi</h4>
    </header>

    <!-- İçerik Alanı -->
    <main class="content px-2 mt-4">
        @Body
    </main>
</div>

<style>
    .liquid-glass-card {
        background: rgba(255, 255, 255, 0.65);
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
        border: 1px solid rgba(255, 255, 255, 0.4);
        box-shadow: 0 8px 32px 0 rgba(31, 38, 135, 0.07);
        border-radius: 1.5rem;
    }

    .mac-floating-nav {
        border-radius: 1rem;
    }
</style>
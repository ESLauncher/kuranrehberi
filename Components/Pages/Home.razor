@page "/"
@rendermode InteractiveServer
@inject HttpClient Http

<PageTitle>Kuran-ı Kerim Rehberi</PageTitle>

<div class="main-container p-3 p-md-4">
    <!-- Ana Arama ve Seçim Paneli -->
    <div class="liquid-glass-card p-4 mb-4">
        <div class="row g-3 align-items-center">
            <div class="col-md-6">
                <div class="input-group">
                    <span class="input-group-text bg-transparent border-0">🔍</span>
                    <input type="text" class="form-control border-0 rounded-pill shadow-sm" 
                           placeholder="Sure ara (Duhâ, Mâide, Bakara...) ve Enter'a bas..." 
                           style="background: rgba(255,255,255,0.7);"
                           @bind="aramaMetni" 
                           @bind:event="oninput"
                           @onkeydown="AramaKlavyeKontrol" />
                </div>
            </div>

            <div class="col-md-4">
                <select class="form-select border-0 rounded-pill shadow-sm" 
                        style="background: rgba(255,255,255,0.7);" 
                        value="@seciliSureNo"
                        @onchange="OnSelectChanged">
                    @foreach (var sure in FiltrelenmisSureler)
                    {
                        <option value="@sure.Number">
                            @sure.Number. @sure.TurkceIsim (@sure.ArapcaIsim)
                        </option>
                    }
                </select>
            </div>

            <div class="col-md-2 text-end">
                @if (seciliSureDetay != null)
                {
                    <span class="badge bg-success rounded-pill px-3 py-2 shadow-sm">
                        @seciliSureDetay.AyetSayisi Ayet
                    </span>
                }
            </div>
        </div>
    </div>

    <!-- Yükleniyor Göstergesi -->
    @if (isLoading)
    {
        <div class="text-center py-5 liquid-glass-card">
            <div class="spinner-border text-success" role="status"></div>
            <p class="mt-2 text-muted fw-bold">Sayfalar Yükleniyor...</p>
        </div>
    }
    else
    {
        <!-- Ana İçerik Alanı -->
        <div class="liquid-glass-card p-3 p-md-4 position-relative">
            <div class="text-center mb-3">
                <h3 class="fw-bold text-success mb-1">@seciliSureDetay?.TurkceIsim Suresi</h3>
                <span class="text-muted small">@seciliSureDetay?.ArapcaIsim</span>
            </div>

            <!-- Sayfalandırma Konteyneri (Oklar ve Liste) -->
            <div class="d-flex align-items-center justify-content-between gap-2">
                
                <!-- Sol Ok -->
                <button @onclick="() => SayfaDegistir(-1)" 
                        class="btn rounded-circle p-3 shadow-sm nav-arrow-btn flex-shrink-0" 
                        style="opacity: @(aktifSayfa == 0 ? "0.3" : "1"); pointer-events: @(aktifSayfa == 0 ? "none" : "auto");">
                    ◀
                </button>

                <!-- Sıralı Ayet Listesi (Her ayet kendi kutusunda alt alta) -->
                <div class="flex-grow-1 px-1 d-flex flex-column gap-3">
                    @if (sayfaAyetler != null && sayfaMealAyetler != null && sayfaSesAyetler != null)
                    {
                        @for (int i = 0; i < sayfaAyetler.Count; i++)
                        {
                            var ayet = sayfaAyetler[i];
                            var mealAyet = sayfaMealAyetler[i];
                            var sesAyet = sayfaSesAyetler[i];
                            string metin = ayet.Text;

                            if (seciliSureNo != 1 && seciliSureNo != 9 && aktifSayfa == 0 && i == 0)
                            {
                                const string bismillah = "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ";
                                if (metin.StartsWith(bismillah))
                                {
                                    metin = metin.Substring(bismillah.Length).Trim();
                                }
                            }

                            <div class="p-3 p-md-4 rounded-4 shadow-sm ayah-row-card" style="background: rgba(255,255,255,0.75); border-left: 5px solid #059669;">
                                <div class="d-flex justify-content-between align-items-center mb-2 flex-wrap gap-2 border-bottom pb-2">
                                    <span class="fw-bold text-success">[@mealAyet.NumberInSurah. Ayet]</span>
                                    @if (!string.IsNullOrEmpty(sesAyet.Audio))
                                    {
                                        <audio controls class="audio-player">
                                            <source src="@sesAyet.Audio" type="audio/mpeg">
                                        </audio>
                                    }
                                </div>

                                <div class="text-end my-3" style="direction: rtl;">
                                    <span class="arabic-ayah-text">
                                        @metin <span class="quran-number">۝@ArapcaRakamCevir(ayet.NumberInSurah)</span>
                                    </span>
                                </div>

                                <div class="text-dark fs-6 fs-md-5 pt-2 border-top" style="text-align: justify;">
                                    @mealAyet.Text
                                </div>
                            </div>
                        }
                    }
                </div>

                <!-- Sağ Ok -->
                <button @onclick="() => SayfaDegistir(1)" 
                        class="btn rounded-circle p-3 shadow-sm nav-arrow-btn flex-shrink-0" 
                        style="opacity: @(aktifSayfa >= ToplamSayfa - 1 ? "0.3" : "1"); pointer-events: @(aktifSayfa >= ToplamSayfa - 1 ? "none" : "auto");">
                    ▶
                </button>

            </div>

            <!-- Sayfa Göstergesi -->
            <div class="text-center mt-4">
                <span class="badge bg-success bg-opacity-75 text-white rounded-pill px-4 py-2 shadow-sm">
                    Sayfa @(aktifSayfa + 1) / @ToplamSayfa
                </span>
            </div>
        </div>
    }
</div>

<style>
    body {
        background: linear-gradient(135deg, #e0f2fe, #f0fdf4);
        min-height: 100vh;
        font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
    }

    .main-container {
        max-width: 900px;
        margin: 0 auto;
    }

    .liquid-glass-card {
        background: rgba(255, 255, 255, 0.65);
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
        border: 1px solid rgba(255, 255, 255, 0.4);
        box-shadow: 0 8px 32px 0 rgba(31, 38, 135, 0.07);
        border-radius: 1.5rem;
    }

    .arabic-ayah-text {
        font-family: 'Amiri', serif;
        font-size: 1.6rem;
        color: #1f2937;
        line-height: 2.2;
    }

    .quran-number {
        font-family: 'Amiri', serif;
        color: #059669;
        font-size: 1.3rem;
        font-weight: bold;
        unicode-bidi: isolate;
        display: inline-block;
        margin: 0 4px;
    }

    .nav-arrow-btn {
        background: rgba(255, 255, 255, 0.9);
        border: 1px solid rgba(255, 255, 255, 0.6);
        transition: all 0.2s ease-in-out;
    }

    .nav-arrow-btn:hover {
        background: #ffffff;
        transform: scale(1.05);
    }

    .audio-player {
        height: 30px;
        max-width: 200px;
    }

    .ayah-row-card {
        transition: transform 0.2s ease;
    }
    .ayah-row-card:hover {
        background: rgba(255, 255, 255, 0.9) !important;
    }
</style>

@code {
    private string aramaMetni = "";
    private int seciliSureNo = 1;
    private SurahInfo? seciliSureDetay;
    private bool isLoading = false;

    private List<AyahItem> tumArapcaAyetler = new();
    private List<AyahItem> tumMealAyetler = new();
    private List<AyahItem> tumSesAyetler = new();

    private int aktifSayfa = 0;
    private const int ayetSayisiSayfaBasina = 4;

    private int ToplamSayfa => tumArapcaAyetler.Count > 0 
        ? (int)Math.Ceiling(tumArapcaAyetler.Count / (double)ayetSayisiSayfaBasina) 
        : 1;

    private int baslangicIndex => aktifSayfa * ayetSayisiSayfaBasina;

    private List<AyahItem> sayfaAyetler => tumArapcaAyetler.Skip(baslangicIndex).Take(ayetSayisiSayfaBasina).ToList();
    private List<AyahItem> sayfaMealAyetler => tumMealAyetler.Skip(baslangicIndex).Take(ayetSayisiSayfaBasina).ToList();
    private List<AyahItem> sayfaSesAyetler => tumSesAyetler.Skip(baslangicIndex).Take(ayetSayisiSayfaBasina).ToList();

    private IEnumerable<SurahInfo> FiltrelenmisSureler =>
        string.IsNullOrWhiteSpace(aramaMetni)
            ? TumSureler
            : TumSureler.Where(s => NormalizeString(s.TurkceIsim).Contains(NormalizeString(aramaMetni)) || 
                                     s.Number.ToString() == aramaMetni.Trim());

    private string NormalizeString(string text)
    {
        return text.ToLowerInvariant()
                   .Replace("â", "a").Replace("î", "i").Replace("û", "u")
                   .Replace("ç", "c").Replace("ğ", "g").Replace("ı", "i")
                   .Replace("ö", "o").Replace("ş", "s").Replace("ü", "u")
                   .Replace("'", "").Replace("-", "").Trim();
    }

    protected override async Task OnInitializedAsync()
    {
        await SureYukle(1);
    }

    private async Task OnSelectChanged(ChangeEventArgs e)
    {
        if (e.Value != null && int.TryParse(e.Value.ToString(), out int yeniNo))
        {
            await SureYukle(yeniNo);
        }
    }

    // Arama kutusunda Enter'a basıldığında çalışır
    private async Task AramaKlavyeKontrol(Microsoft.AspNetCore.Components.Web.KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            var ilkEslesme = FiltrelenmisSureler.FirstOrDefault();
            if (ilkEslesme != null)
            {
                await SureYukle(ilkEslesme.Number);
            }
        }
    }

    private async Task SureYukle(int sureNo)
    {
        seciliSureNo = sureNo;
        isLoading = true;
        seciliSureDetay = TumSureler.FirstOrDefault(s => s.Number == sureNo);
        aktifSayfa = 0;

        StateHasChanged();

        try
        {
            var url = $"https://api.alquran.cloud/v1/surah/{sureNo}/editions/quran-uthmani,tr.diyanet,ar.alafasy";
            var response = await Http.GetFromJsonAsync<QuranApiResponse<List<SurahEditionData>>>(url);

            if (response?.Data != null && response.Data.Count >= 3)
            {
                tumArapcaAyetler = response.Data[0].Ayahs ?? new();
                tumMealAyetler = response.Data[1].Ayahs ?? new();
                tumSesAyetler = response.Data[2].Ayahs ?? new();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Ayet yükleme hatası: {ex.Message}");
        }
        finally
        {
            isLoading = false;
        }
    }

    private void SayfaDegistir(int yon)
    {
        aktifSayfa += yon;
        if (aktifSayfa < 0)
        {
            aktifSayfa = 0;
        }
        else if (aktifSayfa >= ToplamSayfa)
        {
            aktifSayfa = ToplamSayfa - 1;
        }
    }

    private string ArapcaRakamCevir(int number)
    {
        string numStr = number.ToString();
        string arapcaRakamlar = "";
        foreach (char c in numStr)
        {
            switch (c)
            {
                case '0': arapcaRakamlar += "٠"; break;
                case '1': arapcaRakamlar += "١"; break;
                case '2': arapcaRakamlar += "٢"; break;
                case '3': arapcaRakamlar += "٣"; break;
                case '4': arapcaRakamlar += "٤"; break;
                case '5': arapcaRakamlar += "٥"; break;
                case '6': arapcaRakamlar += "٦"; break;
                case '7': arapcaRakamlar += "٧"; break;
                case '8': arapcaRakamlar += "٨"; break;
                case '9': arapcaRakamlar += "٩"; break;
            }
        }
        return arapcaRakamlar;
    }

    public class SurahInfo
    {
        public int Number { get; set; }
        public string TurkceIsim { get; set; } = string.Empty;
        public string ArapcaIsim { get; set; } = string.Empty;
        public int AyetSayisi { get; set; }
    }

    public class QuranApiResponse<T>
    {
        public int Code { get; set; }
        public T? Data { get; set; }
    }

    public class SurahEditionData
    {
        public List<AyahItem> Ayahs { get; set; } = new();
    }

    public class AyahItem
    {
        public int NumberInSurah { get; set; }
        public string Text { get; set; } = string.Empty;
        public string Audio { get; set; } = string.Empty;
    }

